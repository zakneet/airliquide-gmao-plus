# Copier vers backend/.env (jamais versionné)
DJANGO_SECRET_KEY=change-me-with-at-least-32-characters
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# sqlite (dev rapide) ou postgres
DB_ENGINE=sqlite
DB_NAME=gmao
DB_USER=gmao
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
CORS_ALLOWED_ORIGINS=http://localhost:3000
